{
  "name": "LuminaRust",
  "tiers": {
    "fast": {
      "floor": 1
    }
  },
  "rules": {
    "rust-file-line-ceiling": {
      "class": "oversized Rust source file",
      "incident": "RATCHET-CLI-1K-MIGRATION-99: existing Rust files above the 1000-line target are individually excepted",
      "unit": "lines (maximum per file)",
      "direction": "ceiling",
      "tier": "fast",
      "aggregate": "max",
      "description": "Unexcepted Rust files are capped at 1000 physical lines",
      "count": {
        "file_metrics": {
          "files": [
            "crates/**/*.rs",
            "agent-harness/**/*.rs"
          ],
          "metric": "line_count"
        }
      },
      "scopes": [
        {
          "id": "crates-lumina-gui-src-lib-rs",
          "description": "Existing exception: crates/lumina-gui/src/lib.rs",
          "file": "crates/lumina-gui/src/lib.rs"
        }
      ]
    }
  }
}
